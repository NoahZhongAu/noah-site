# Copy to .env.local. Every variable is read on the server unless prefixed NEXT_PUBLIC_.

# Resend API key for the contact form (milestone 6).
RESEND_API_KEY=
# Address the contact form delivers to.
CONTACT_TO_EMAIL=
# Cloudflare Turnstile secret, verified server-side.
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key, rendered in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Canonical origin, no trailing slash, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
